# Public browser configuration — safe to expose in the client bundle.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.testnet.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadscan.com
NEXT_PUBLIC_DROPS_CONTRACT_ADDRESS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values — never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
LIT_NETWORK=naga-dev
LIT_ACCOUNT_API_KEY=
DEPLOYER_PRIVATE_KEY=
CONFIRM_MONAD_DEPLOY=

# Gate T1 live runner only (tool/threshold-spike). Never put these in NEXT_PUBLIC_*.
# DROPS_CONTRACT_ADDRESS=
# RECIPIENT_PRIVATE_KEY=
# STRANGER_PRIVATE_KEY=
# THRESHOLD_SPIKE_RUN=
