# NO SUS Canary: every secret and setting, with no values.
# Nothing here is needed to run the app locally (it uses the hosted devnet backend).
# Real values go in Supabase function secrets (`supabase secrets set ...`) or a git-ignored
# .env file. Never commit a filled-in copy. See docs/SELF_HOSTING.md.

# --- Relayer: Supabase Edge Function `canary` (function secrets) ---
# 64 hex chars, random (openssl rand -hex 32). Salts the anonymous reader tag. Never share it.
CANARY_TAG_SALT=
# Devnet relayer keypairs, comma-separated: base58 64-byte secret keys or solana-keygen JSON
# arrays. Fund them at https://faucet.solana.com. Devnet only.
SOLANA_RELAYER_KEYS=
# Optional. Default https://api.devnet.solana.com
SOLANA_RPC_URL=
# Optional. Default MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr (SPL Memo)
SOLANA_MEMO_PROGRAM=
# Leave unset. Setting it turns on a legacy prototype path the product does not use.
CANARY_CONTRACT_ADDRESS=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase. Never set them by hand
# and never put the service-role key in the app.

# --- Flutter build (--dart-define, public by design) ---
# true = the standalone Canary web app that is deployed.
NOSUS_CANARY_ONLY=true
# Repo link shown in the app.
CANARY_REPO_URL=https://github.com/https-shubhamsahu/nosus-canary

# --- tool/solana-spike (optional, local only) ---
# The spike writes its own devnet key to tool/solana-spike/.keys/ (git-ignored).
