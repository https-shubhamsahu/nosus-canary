{
  "name": "@nosus/receipts",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test",
    "check": "deno check mod.ts cli.ts test/",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "publish": {
    "include": [
      "mod.ts",
      "cli.ts",
      "src/",
      "README.md"
    ]
  }
}
